@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-container">
    <!-- Welcome Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Välkommen tillbaka 👋</h1>
            <p class="page-subtitle">Din smarta dokumentationsassistent är redo att hjälpa dig idagy</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card stat-blue">
            <div class="stat-content">
                <p class="stat-label">Totalt Dokument</p>
                <h2 class="stat-value">0</h2>
            </div>
            <div class="stat-icon stat-icon-blue">
                <i class="fas fa-file-medical"></i>
            </div>
            
        </div>

        <div class="stat-card stat-teal">
            <div class="stat-content">
                <p class="stat-label">Knowledge Files</p>
                <h2 class="stat-value">0</h2>
            </div>
            <div class="stat-icon stat-icon-teal">
                <i class="fas fa-book-open"></i>
            </div>
        </div>

        <div class="stat-card stat-pink">
            <div class="stat-content">
                <p class="stat-label">Reflektionsläge</p>
                <h2 class="stat-value">0</h2>
            </div>
            <div class="stat-icon stat-icon-pink">
                <i class="fas fa-heart"></i>
            </div>
        </div>

        <div class="stat-card stat-green">
            <div class="stat-content">
                <p class="stat-label">Sparad tid</p>
                <h2 class="stat-value">0 min</h2>
            </div>
            <div class="stat-icon stat-icon-green">
                <i class="fas fa-clock"></i>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="section-header">
        <h2 class="section-title">Snabbåtgärder</h2>
    </div>

    <div class="quick-actions-grid">
        <a href="@Url.Action("Create", "Notes")" class="action-card action-card-blue">
            <div class="action-icon action-icon-blue">
                <i class="fas fa-file-medical"></i>
            </div>
            <h3 class="action-title">Skapa ny anteckning</h3>
            <p class="action-description">Skapa strukturerad dokumentation med AI</p>
            <div class="action-link">
                <span>Get started</span>
                <i class="fas fa-arrow-right"></i>
            </div>
        </a>

        <a href="@Url.Action("Index", "AIChat")" class="action-card action-card-teal">
            <div class="action-icon action-icon-teal">
                <i class="fas fa-robot"></i>
            </div>
            <h3 class="action-title">Fråga AI-assistenten</h3>
            <p class="action-description">Få hjälp med dokumentationsfrågor</p>
            <div class="action-link">
                <span>Get started</span>
                <i class="fas fa-arrow-right"></i>
            </div>
        </a>

        <a href="@Url.Action("Reflection", "Home")" class="action-card action-card-pink">
            <div class="action-icon action-icon-pink">
                <i class="fas fa-heart"></i>
            </div>
            <h3 class="action-title">Starta reflektion</h3>
            <p class="action-description">Reflektera över dagens upplevelser</p>
            <div class="action-link">
                <span>Kom igång</span>
                <i class="fas fa-arrow-right"></i>
            </div>
        </a>
    </div>

    <!-- Recent Activity -->
    <div class="content-grid">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-file-medical"></i>
                    Nya anteckningar 
                </h3>
                <a href="@Url.Action("Index", "Notes")" class="btn-text">
                    Visa alla
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
            <div class="card-body">
                <div class="empty-state">
                    <i class="fas fa-file-medical empty-state-icon"></i>
                    <p class="empty-state-text">Inga dokument än</p>
                    <a href="@Url.Action("Create", "Notes")" class="btn btn-primary btn-sm">
                        Skapa din första anteckning
                    </a>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-heart"></i>
                    Senaste reflektioner
                </h3>
                <a href="@Url.Action("Reflection", "Home")" class="btn-text">
                    Visa alla
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
            <div class="card-body">
                <div class="empty-state">
                    <i class="fas fa-heart empty-state-icon"></i>
                    <p class="empty-state-text">Ingen reflektioner än</p>
                    <a href="@Url.Action("Reflection", "Home")" class="btn btn-pink btn-sm">
                        Starta reflektioner
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>