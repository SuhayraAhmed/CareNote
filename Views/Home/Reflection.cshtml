@{
    ViewData["Title"] = "Stöd & Resurser";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title"><i class="fas fa-hands-helping"></i> Stöd & Resurser</h1>
            <p class="page-subtitle">Hjälp och vägledning för din vardag som sjuksköterska</p>
        </div>
    </div>

    <!-- Simple Resources Grid -->
    <div class="resources-grid">
        <div class="resource-card">
            <div class="resource-icon">
                <i class="fas fa-phone-alt"></i>
            </div>
            <h3>Akut hjälp</h3>
            <p>Jourhavande medmänniska</p>
            <strong>08-702 16 80</strong>
            <small>18-24 alla dagar</small>
        </div>

        <div class="resource-card">
            <div class="resource-icon">
                <i class="fas fa-heartbeat"></i>
            </div>
            <h3>1177</h3>
            <p>Hälsoinformation och råd</p>
            <a href="https://1177.se" target="_blank" class="btn btn-primary btn-sm">Besök 1177.se</a>
        </div>

        <div class="resource-card">
            <div class="resource-icon">
                <i class="fas fa-user-md"></i>
            </div>
            <h3>Vårdcentral</h3>
            <p>Första kontakt för psykisk hälsa</p>
            <small>Boka tid via 1177</small>
        </div>

        <div class="resource-card">
            <div class="resource-icon">
                <i class="fas fa-hands-helping"></i>
            </div>
            <h3>Vårdförbundet</h3>
            <p>Stöd för medlemmar</p>
            <a href="https://vardforbundet.se/stod" target="_blank" class="btn btn-outline-primary btn-sm">Läs mer</a>
        </div>

        <div class="resource-card">
            <div class="resource-icon">
                <i class="fas fa-book"></i>
            </div>
            <h3>Självhjälp</h3>
            <p>Gratis resurser online</p>
            <a href="https://mindfulness.se" target="_blank" class="btn btn-outline-primary btn-sm">Mindfulness</a>
        </div>

        <div class="resource-card">
            <div class="resource-icon">
                <i class="fas fa-users"></i>
            </div>
            <h3>Kollegialt stöd</h3>
            <p>Prata med kollegor och chefer</p>
            <small>Din arbetsplats är en viktig resurs</small>
        </div>
    </div>

    <!-- Simple Tips -->
    <div class="card mt-4">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-lightbulb"></i> Enkla tips för vardagen</h3>
        </div>
        <div class="card-body">
            <div class="tips-list">
                <div class="tip-item">
                    <i class="fas fa-walking"></i>
                    <div>
                        <strong>Rör på dig</strong>
                        <p>Korta promenader på raster kan göra stor skillnad</p>
                    </div>
                </div>
                <div class="tip-item">
                    <i class="fas fa-glass-whiskey"></i>
                    <div>
                        <strong>Hydrera</strong>
                        <p>Kom ihåg att dricka vatten under arbetspasset</p>
                    </div>
                </div>
                <div class="tip-item">
                    <i class="fas fa-pause"></i>
                    <div>
                        <strong>Ta pauser</strong>
                        <p>Korta mentala pauser hjälper att återhämta sig</p>
                    </div>
                </div>
                <div class="tip-item">
                    <i class="fas fa-comments"></i>
                    <div>
                        <strong>Prata ut</strong>
                        <p>Dela med dig av utmaningar med kollegor</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .resources-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .resource-card {
        background: white;
        padding: 25px;
        border-radius: 10px;
        border: 1px solid #e0e0e0;
        text-align: center;
        transition: transform 0.2s;
    }

    .resource-card:hover {
        transform: translateY(-5px);
    }

    .resource-icon {
        font-size: 40px;
        color: #007bff;
        margin-bottom: 15px;
    }

    .resource-card h3 {
        margin: 10px 0;
        color: #333;
    }

    .resource-card p {
        color: #666;
        margin-bottom: 10px;
    }

    .tips-list {
        display: grid;
        gap: 15px;
    }

    .tip-item {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
    }

    .tip-item i {
        color: #007bff;
        margin-top: 3px;
    }

    .tip-item strong {
        display: block;
        margin-bottom: 5px;
    }

    .tip-item p {
        margin: 0;
        color: #666;
    }

    @@media (max-width: 768px) {
        .resources-grid {
            grid-template-columns: 1fr;
        }
        
        .tip-item {
            flex-direction: column;
            text-align: center;
        }
    }
</style>