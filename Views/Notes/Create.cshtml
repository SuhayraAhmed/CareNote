@model CareNote.Models.Note
@using CareNote.Models

@{
    ViewData["Title"] = "Ny Anteckning";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">Ny Anteckning</h1>
            <p class="page-subtitle">Skapa ny patientanteckning</p>
        </div>
        <a asp-action="Index" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i>
            Tillbaka
        </a>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-notes-medical"></i>
                Patientinformation
            </h3>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post" class="note-form">

                <div class="form-group">
                    <label asp-for="Patient" class="form-label">
                        <i class="fas fa-user"></i>
                        Patient
                    </label>
                    <input asp-for="Patient"
                           class="form-input"
                           placeholder="Ange patientens namn"
                           required />
                    <span asp-validation-for="Patient" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Priority" class="form-label">
                        <i class="fas fa-exclamation-circle"></i>
                        Prioritet
                    </label>
                    <select asp-for="Priority"
                            class="form-select"
                            asp-items="Html.GetEnumSelectList<Priority>()">
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Text" class="form-label">
                        <i class="fas fa-sticky-note"></i>
                        Anteckning
                    </label>
                    <textarea asp-for="Text"
                              class="form-textarea"
                              rows="10"
                              placeholder="Skriv din anteckning här..."
                              required></textarea>
                    <span asp-validation-for="Text" class="text-danger"></span>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-outline" onclick="clearForm()">
                        <i class="fas fa-times"></i> Rensa
                    </button>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Spara Anteckning
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function clearForm() {
            if (confirm('Rensa all inmatad data?')) {
                document.querySelector('.note-form').reset();
            }
        }
    </script>
}
